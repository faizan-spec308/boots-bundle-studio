# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Monday.com API
MONDAY_API_TOKEN=your_monday_api_token_here
MONDAY_BOARD_ID=5100428483

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# File paths
# UPLOADS_DIR is the only one the backend reads; it stores downloaded,
# generated, and approved images plus the approvals store (_approved.json).
UPLOADS_DIR=./uploads

# Optional: restrict browser origins allowed to call the API (comma-separated).
# Leave unset for local dev ("*"); set to your Vercel URL in production.
# CORS_ORIGINS=https://your-app.vercel.app

# Boots crawler
BOOTS_X_AGENT_CLIENT=W-7njoVr89mFAk
